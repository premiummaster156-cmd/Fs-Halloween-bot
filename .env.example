DISCORD_TOKEN=
CLIENT_ID=
# Browser-based command IDE (Discord OAuth2 identify scope)
DISCORD_CLIENT_SECRET=
IDE_PUBLIC_URL=https://your-dashboard-domain.example
IDE_GUILD_ID=
# IDE_PORT defaults to the hosting provider's PORT or 3000
IDE_PORT=
# Optional: instant command registration in one test server
GUILD_ID=
# Fukishokai's Neon project (kept for Fukishokai game data)
DATABASE_URL=
# Separate Neon project created for CoopFT. Never reuse DATABASE_URL here.
COOPFT_DATABASE_URL=
OWNER_ID=
# Optional persistent directory for rotating runtime logs. Defaults to ./logs.
BOT_LOG_DIR=./logs
# Warn in runtime logs when resident memory exceeds this many MB; set 0 to disable.
BOT_MEMORY_WARN_MB=200
# Legacy only; does not grant bot-control access.
ADMIN_ROLE_IDS=
LOG_CHANNEL_ID=
# Optional public welcome channel for Fukishōkai; defaults to the system channel.
WELCOME_CHANNEL_ID=
HALLOWEEN_ROLE_ID=
HALLOWEEN_ENDS_AT=2026-11-30T00:00:00.000Z
STARTING_WALLET=5000
CURRENCY_NAME=FS Coins
CURRENCY_SYMBOL=FC

# Separate per-server identities and command sets. COOPFT defaults to the configured CoopFT server.
COOPFT_GUILD_ID=1498271944456540210
FUKISHOKAI_GUILD_ID=
# Optional one-time deletion of all ordinary editable roles below the bot's role.
# First boot stores a preview and deletes nothing unless this exact value is set after reviewing it.
COOPFT_ROLE_CLEANUP_CONFIRM=
# Optional comma-separated role IDs to preserve during the one-time cleanup.
COOPFT_KEEP_ROLE_IDS=
